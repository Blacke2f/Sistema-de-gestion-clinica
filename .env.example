# ══════════════════════════════════════════════════════════════
# SISGECLIN — Variables de Entorno
# Sistema de Gestión Clínica v2.5
# ══════════════════════════════════════════════════════════════
# Copiar este archivo como .env y ajustar los valores

# ── Aplicación ────────────────────────────────────────────────
APP_NAME=SISGECLIN
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/SISGECLIN/public

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_DO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logs ──────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de Datos (MySQL) ─────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sisgeclin_laravel
DB_USERNAME=root
DB_PASSWORD=

# ── Sesiones ──────────────────────────────────────────────────
# Driver 'file' recomendado para XAMPP (no requiere tabla en BD)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ── Cache ─────────────────────────────────────────────────────
CACHE_STORE=file

# ── Cola de trabajos ──────────────────────────────────────────
QUEUE_CONNECTION=sync

# ── Sistema de archivos ───────────────────────────────────────
FILESYSTEM_DISK=local

# ── Correo (opcional) ─────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sisgeclin.com"
MAIL_FROM_NAME="${APP_NAME}"
